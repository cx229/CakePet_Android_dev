<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_btn_outline"
    android:padding="12dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/role_thumb"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="fitCenter"
            android:background="@drawable/bg_thumb_border"
            android:clipToOutline="true"
            android:layout_marginEnd="12dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/role_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/role_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textColor="@color/cp_hint_dark"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- 召唤前：[召唤, 设置]；召唤后：[归位, 召回, 设置]。
         顺序为 召唤→召回→设置：未召唤时 btn_recall 隐藏(GONE)，故视觉为 [召唤, 设置]；
         已召唤时三者皆显，视觉为 [归位, 召回, 设置]，设置始终居右。
         按钮用 Material 描边样式：白底(app:backgroundTint)、黑边框(app:strokeColor)、黑字，
         以在 MaterialComponents 主题下正确生效（android:background 会被 backgroundTint 覆盖）。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp">
        <Button
            android:id="@+id/btn_summon"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="召唤"
            android:textColor="@color/black"
            app:backgroundTint="@color/white"
            app:strokeColor="@color/black"
            app:strokeWidth="1.5dp"
            app:cornerRadius="14dp"
            android:layout_marginEnd="6dp"/>
        <Button
            android:id="@+id/btn_recall"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="召回"
            android:textColor="@color/black"
            app:backgroundTint="@color/white"
            app:strokeColor="@color/black"
            app:strokeWidth="1.5dp"
            app:cornerRadius="14dp"
            android:layout_marginHorizontal="6dp"/>
        <Button
            android:id="@+id/btn_settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="设置"
            android:textColor="@color/black"
            app:backgroundTint="@color/white"
            app:strokeColor="@color/black"
            app:strokeWidth="1.5dp"
            app:cornerRadius="14dp"
            android:layout_marginStart="6dp"/>
    </LinearLayout>
</LinearLayout>
